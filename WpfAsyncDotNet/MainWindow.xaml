<Window
    x:Class="WpfAsync.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WpfAsync"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="698"
    Height="136"
    mc:Ignorable="d">
    <Window.Resources>
        <local:IntToKoleckaConverter x:Key="IntToKoleckaConverterKey" />
    </Window.Resources>
    <StackPanel>
        <Button Click="Button_Click_Prace" Content="Moc práce" />
        <!--
            Binding na Counter a Vrtule bude hledat v rozsahu definovaném
            v MainWindow.xaml.cs: Rozsah je v proměnné DataContext
        -->
        <TextBox
            x:Name="MocpraceText"
            Text="{Binding Counter, Converter={StaticResource IntToKoleckaConverterKey}}"
            TextAlignment="Center" />
        <Button Click="Button_Click_Vrt" Content="Vrť" />
        <TextBox
            x:Name="VrtText"
            Text="{Binding Vrtule}"
            TextAlignment="Center" />
    </StackPanel>
</Window>
